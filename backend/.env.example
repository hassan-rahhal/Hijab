PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hijab_home
DB_SSL=false

# Cloudinary — used for product photo uploads (required for Vercel deployment,
# since serverless hosting can't store uploaded files on local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram order notifications — see TELEGRAM_SETUP.md for how to get these
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel login — change these to your own secret values
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
JWT_SECRET=change_this_to_a_long_random_string
